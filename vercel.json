    },
    "app/api/gsc/sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/bing/sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/tick/route.ts": {
      "maxDuration": 300
    }
  }
}
