# ============ REQUIRED ============
DATABASE_URL=postgresql://crawlseo:changeme@localhost:5432/crawlseo

# ============ DOCKER COMPOSE DB CREDENTIALS ============
# These are referenced by docker-compose.yml; set your own for non-local deployments.
# :latest is the latest release. Override to pin a release (:0.2.6), follow
# main (:edge) or use an image built from a fork.
# CRAWLSEO_IMAGE=ghcr.io/crawlseo/crawlseo:latest
POSTGRES_USER=crawlseo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crawlseo

# ============ GOOGLE OAUTH (required for GSC data) ============
# Get these from: https://console.cloud.google.com/
# Required scopes: openid, email, profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Optional: PageSpeed Insights API key (higher quota for Core Web Vitals)
# GOOGLE_PAGESPEED_KEY=

# ============ NEXTAUTH / AUTH.JS ============
# The public base URL of the app. On a server, the https URL users open
# (https://seo.example.com). Crawls run in the server process, so crawlseo
# needs a long-running server, not a serverless host.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32. Keep it stable: it also encrypts stored
# API keys and Google tokens.
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
# Required when running behind a reverse proxy such as Coolify
AUTH_TRUST_HOST=true
# AUTH_SECRET works as an alias (the Auth.js v5 name). If both are set,
# NEXTAUTH_SECRET wins. The same value encrypts stored API keys, so changing it
# makes them unreadable.
# AUTH_SECRET=

# ============ OPTIONAL: Crawler ============
# A crawl stops after this many minutes (default 30). Mostly reached on sites
# whose robots.txt sets a Crawl-delay: the crawler then makes one request at a
# time on that host and reports the hosts it had to stop early.
# CRAWL_MAX_MINUTES=30

# ============ OPTIONAL: Registration ============
# Set to true after creating your admin account to prevent new registrations.
# Existing users keep signing in; a Google account that never signed in here is refused.
# DISABLE_REGISTRATION=false

# ============ OPTIONAL: crawlseo.cloud card ============
# The sidebar shows one card linking to the crawlseo.cloud home page (a plain
# link, no request or analytics). Set to true to remove it for every user.
# CRAWLSEO_HIDE_CLOUD_PROMO=false

# ============ OPTIONAL: Update check ============
# Once a day the server asks the GitHub releases API for the latest crawlseo
# release (only a User-Agent "crawlseo/<version>", no data about you) and the
# sidebar shows "Update available" when it is newer. Set to false to turn it
# off completely: no request is made.
# CRAWLSEO_UPDATE_CHECK=true

# ============ NODE ENVIRONMENT ============
# NODE_ENV=development
